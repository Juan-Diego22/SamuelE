---
import "@fontsource/dancing-script/latin-400.css";
import "../styles/global.css";

interface Props {
  title: string;
  /** Descripción para buscadores y vista previa al compartir (HU-04). */
  description?: string;
  /** Ruta o URL de la imagen de vista previa; se vuelve absoluta con el origen actual. */
  image?: string;
  ogType?: string;
  /** `catalog`: ancho de lectura mayor para la grilla pública. */
  variant?: "default" | "catalog";
}

const { title, description, image, ogType = "website", variant } = Astro.props;
const imageUrl = image ? new URL(image, Astro.url.origin).href : undefined;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {description && (
      <>
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:type" content={ogType} />
        <meta property="og:url" content={Astro.url.href} />
        <meta property="og:locale" content="es_CO" />
        {imageUrl && <meta property="og:image" content={imageUrl} />}
      </>
    )}
  </head>
  <body>
    <main class={variant === "catalog" ? "catalog" : undefined}>
      <slot />
    </main>
  </body>
</html>
