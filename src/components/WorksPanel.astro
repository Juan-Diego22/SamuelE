---
import PanelHeader from "./PanelHeader.astro";
import RetireDialog from "./RetireDialog.astro";
import WorkCard from "./WorkCard.astro";
import { MESSAGES } from "../lib/works/messages";
import type { PanelItem } from "../lib/works/list";

interface Props {
  /** Trabajos ya ordenados; `undefined` si no se pudieron cargar. */
  items?: PanelItem[];
  /** Mensaje de error ya resuelto cuando falló la carga. */
  error?: string;
  /** Muestra el aviso de que se acaba de publicar un trabajo. */
  published?: boolean;
  /** Aviso de la acción que acaba de ocurrir; solo se muestra uno. */
  notice?: "retired" | "updated" | "notAvailable";
}

const { items, error, published = false, notice } = Astro.props;
---

<PanelHeader title="Mis trabajos" />
<a class="btn-primary btn-block" href="/admin/works/new">
  + Nuevo trabajo
</a>
{published && (
  <p class="form-success" role="status">
    Trabajo publicado.
  </p>
)}
{notice && (
  <p class="form-success" role="status">
    {MESSAGES[notice]}
  </p>
)}
{error ? (
  <p class="form-error" role="alert">
    {error}
  </p>
) : items && items.length > 0 ? (
  <ul class="work-list">
    {items.map((item) => (
      <WorkCard item={item} />
    ))}
  </ul>
) : (
  <p class="notice empty-state">
    Todavía no tienes trabajos. Publica el primero.
  </p>
)}
<RetireDialog />
