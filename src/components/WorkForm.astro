---
import PhotoDrop from "./PhotoDrop.astro";
import type { Category } from "../lib/works/store";
import { MAX_DESCRIPTION_LENGTH, MAX_TITLE_LENGTH } from "../lib/works/limits";

import type { EditValues } from "../lib/works/edit-view";

interface Props {
  categories: Category[];
  /** Con él, el formulario edita ese trabajo en lugar de publicar uno nuevo. */
  work?: EditValues;
}

const { categories, work } = Astro.props;
---

<noscript>
  <p class="form-error">Necesitas activar JavaScript para publicar fotos.</p>
</noscript>
<form
  id="work-form"
  class="work-form"
  novalidate
  data-mode={work ? "edit" : "new"}
  data-work-id={work?.id}
  data-photo-version={work?.photoVersion}
>
  <div class="field">
    <label for="photo">
      Foto
      <span class="required" aria-hidden="true">
        {" "}
        *
      </span>
      <span class="sr-only"> (obligatorio)</span>
    </label>
    <PhotoDrop currentPhotoUrl={work?.photoUrl} />
    <p
      id="error-photo"
      class="form-error"
      role="alert"
      data-error-for="photo"
      hidden
    ></p>
  </div>

  <div class="field">
    <label for="category">
      Categoría
      <span class="required" aria-hidden="true">
        {" "}
        *
      </span>
      <span class="sr-only"> (obligatorio)</span>
    </label>
    <select
      id="category"
      name="category"
      required
      aria-describedby="error-category"
    >
      <option value="">Selecciona una categoría</option>
      {categories.map((c) => (
        <option value={String(c.id)} selected={c.id === work?.categoryId}>
          {c.name}
        </option>
      ))}
    </select>
    <p
      id="error-category"
      class="form-error"
      role="alert"
      data-error-for="category"
      hidden
    ></p>
  </div>

  <div class="field">
    <label for="title">
      Título
      <span class="required" aria-hidden="true">
        {" "}
        *
      </span>
      <span class="sr-only"> (obligatorio)</span>
    </label>
    <input
      id="title"
      name="title"
      type="text"
      maxlength={MAX_TITLE_LENGTH}
      placeholder="Ej: Torta de Chocolate"
      required
      value={work?.title}
      aria-describedby="error-title"
    />
    <p
      id="error-title"
      class="form-error"
      role="alert"
      data-error-for="title"
      hidden
    ></p>
  </div>

  <div class="field">
    <label for="description">Descripción (opcional)</label>
    <textarea
      id="description"
      name="description"
      rows="4"
      placeholder="Describe los ingredientes, tamaño, etc."
      maxlength={MAX_DESCRIPTION_LENGTH}
      aria-describedby="error-description"
    >{work?.description}</textarea>
    <p
      id="error-description"
      class="form-error"
      role="alert"
      data-error-for="description"
      hidden
    ></p>
  </div>

  <p
    id="error-form"
    class="form-error"
    role="alert"
    data-error-for="form"
    hidden
  ></p>

  <button type="submit" class="btn-primary">
    {work ? "Guardar" : "Publicar"}
  </button>
  <a class="btn-secondary" href="/admin">
    Cancelar
  </a>
</form>

<script>
  import "../scripts/work-form";
</script>
