---
import CatalogMessage from "./CatalogMessage.astro";
import { CATALOG_MESSAGES } from "../lib/catalog/messages";
import type { DetailData } from "../lib/catalog/detail";

interface Props {
  data: DetailData;
  /** Dirección actual (ruta y consulta) para "Reintentar". */
  retryHref?: string;
}

const { data, retryHref = "/" } = Astro.props;
---

{data.state === "found" ? (
  <article class="detail">
    <a class="back-link" href="/" data-back>
      {CATALOG_MESSAGES.back}
    </a>
    <span class="photo-box detail-photo">
      <img
        src={data.view.photoMd}
        srcset={`${data.view.photoMd} 900w, ${data.view.photoLg} 1600w`}
        sizes="(min-width: 48rem) 36rem, 100vw"
        alt={data.view.alt}
        width="900"
        height="900"
        decoding="async"
        fetchpriority="high"
        data-photo
      />
    </span>
    <p class="detail-tag">{data.view.category}</p>
    <h1 class="detail-title">{data.view.title}</h1>
    {data.view.description && (
      <p class="detail-description">{data.view.description}</p>
    )}
    <a
      class="btn-primary btn-block"
      href={data.view.whatsappUrl}
      target="_blank"
      rel="noopener noreferrer"
    >
      {CATALOG_MESSAGES.askWhatsapp}
    </a>
  </article>
) : data.state === "notFound" ? (
  <CatalogMessage
    message={CATALOG_MESSAGES.detailUnavailable}
    action={{ href: "/", label: CATALOG_MESSAGES.seeCatalog }}
  />
) : (
  <div class="catalog-message">
    <p class="notice" role="alert">
      {CATALOG_MESSAGES.detailFailed}
    </p>
    <a class="btn-primary btn-block" href={retryHref}>
      {CATALOG_MESSAGES.retry}
    </a>
    <a class="btn-secondary" href="/">
      {CATALOG_MESSAGES.seeCatalog}
    </a>
  </div>
)}

<script>
  import "../scripts/back-link";
  import "../scripts/photo-fallback";
</script>
